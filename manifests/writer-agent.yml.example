agent_type: writer
description: "Writer agent — forge documentation"

max_auto_risk: low
interaction_permissions:
  auto_approved:
    - developer   # doc queue entries from builds
    - sysadmin    # doc queue entries from infra builds
    - research    # doc queue entries from research
  needs_approval: []

credentials:
  source: vault
  vault:
    addr: "${VAULT_ADDR}"
    auth: approle
    role_id_env: VAULT_ROLE_ID
    secret_id_env: VAULT_SECRET_ID
    path: "agents/{agent_type}"
    kv_version: 2

modules:
  system-ops:
    type: mcp_proxy
    config:
      url: http://localhost:8282/mcp
      tool_denylist:
        - list_processes        # not needed for doc work

  searxng-mcp:
    type: mcp_proxy
    config:
      command: /home/ted/scripts/run-searxng-mcp.sh
      tool_denylist:
        - clear_cache

  qmd:
    type: mcp_proxy
    config:
      url: http://localhost:8181/mcp

  graphiti:
    type: mcp_proxy
    config:
      url: http://localhost:8000/mcp
      tool_denylist:
        - clear_graph

  memory-metadata-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8490/mcp

  memsearch-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8493/mcp
      headers:
        Authorization: "Bearer ${MEMSEARCH_API_TOKEN}"
      tool_denylist: [index_memory]    # MEM-03: search only; no indexing use case for writer agent

  memory-search-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8491/mcp

  githost-mcp:
    type: mcp_proxy
    config:
      command: /home/ted/scripts/run-githost-mcp-writer.py
      env:
        AGENT_ID: writer
      # SECURITY[control]: Repo access restricted to doc repos via ALLOWED_REPO_ROOTS in
      # githost-mcp-writer.env. Writer commits directly to main on doc repos only.
      tool_denylist:
        - git_tag
        - git_checkout            # writer works on main only, no branch switching
        - release
        - npm_publish
        - pypi_publish
        - gitea_create_release
        - github_create_release
        - gitlab_create_release
        - woodpecker_trigger
        - woodpecker_pipeline_cancel
        - woodpecker_list_pipelines
        - woodpecker_get_logs
        - woodpecker_status
        - gitea_pr_create         # writer commits to main, no PRs
        - gitea_pr_merge
        - gitea_pr_comment
        - github_pr_list
        - github_pr_comments
        - gitlab_mr_list
        - audit_log_query

  task-queue-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8485/mcp

  plane-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8495/mcp
      headers:
        Authorization: "Bearer ${PLANE_TOKEN}"
        x-workspace-slug: "${PLANE_WORKSPACE}"
      tool_allowlist:
        - list_projects
        - list_work_items
        - retrieve_work_item
        - create_work_item

  agent-bus:
    type: mcp_proxy
    config:
      command: /home/ted/repos/personal/agent-bus/venv/bin/python3
      args: ["/home/ted/repos/personal/agent-bus/server.py"]

  matrix:
    config:
      allowed_rooms:
        - "<room-id>"    # #writer:helmforge.me

  matrix-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8487/mcp

rate_limits:
  global: "60/minute"
  per_tool:
    "system-ops_run_command": "20/minute"

audit:
  agent_bus_emit: true
  agent_bus_comms_dir: "~/.claude/comms"
  log_args: true

argument_filters:
  - name: "credential-leak"
    pattern: "(password|secret|api[_.]?key|bearer\\s+[A-Za-z0-9])"
    fields: ["*"]
    action: warn
    case_insensitive: true

  - name: "path-traversal"
    pattern: "\\.\\./|\\.\\.\\\\"
    fields: ["path", "file_path", "target", "src", "dst", "destination"]
    action: block
    decode: [url]

  - name: "shell-injection-warn"
    pattern: "rm\\s+-rf\\s+/|>\\s*/etc/|/etc/shadow|/etc/passwd"
    fields: ["command"]
    action: warn

response_filters:
  - name: "response-credential-leak"
    pattern: "(sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|AKIA[A-Z0-9]{16}|ya29\\.[a-zA-Z0-9_-]{50,})"
    action: redact
    decode: [base64]

  - name: "response-injection-attempt"
    pattern: "ignore (all |previous )?(instructions|prompt)|you are now|disregard your"
    action: warn
    case_insensitive: true

workspace_access:
  - path: ~/.claude/memory/agents/writer/
    access: readwrite
    git_backed: false
  - path: ~/.claude/memory/shared/
    access: readwrite
    git_backed: false
  - path: ~/.claude/comms/
    access: readwrite
    git_backed: false
