agent_type: security
description: "Security agent — forge post-build audits"

max_auto_risk: low
interaction_permissions:
  auto_approved:
    - developer   # audit requests from builds
    - sysadmin    # audit requests from infra builds
    - research    # audit requests from research-initiated builds
  needs_approval: []

credentials:
  source: vault
  vault:
    addr: "${VAULT_ADDR}"
    auth: approle
    role_id_env: VAULT_ROLE_ID
    secret_id_env: VAULT_SECRET_ID
    path: "agents/{agent_type}"
    kv_version: 2

modules:
  system-ops:
    type: mcp_proxy
    config:
      url: http://localhost:8282/mcp
      tool_denylist:
        - edit_file             # security writes NEW audit files, never edits existing source

  searxng-mcp:
    type: mcp_proxy
    config:
      command: ${HOME}/scripts/run-searxng-mcp.sh
      tool_denylist:
        - clear_cache

  memory-metadata-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8490/mcp

  memsearch-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8493/mcp
      headers:
        Authorization: "Bearer ${MEMSEARCH_API_TOKEN}"
      tool_denylist: [index_memory]    # MEM-03: search only; no indexing use case for security agent

  task-queue-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8485/mcp

  loki-mcp:
    type: mcp_proxy
    config:
      command: ${HOME}/scripts/run-loki-mcp.sh

  signoz-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8492/mcp
      tool_denylist: []

  agent-bus:
    type: mcp_proxy
    config:
      command: ${HOME}/repos/personal/agent-bus/venv/bin/python3
      args: ["${HOME}/repos/personal/agent-bus/server.py"]

  githost-mcp:
    type: mcp_proxy
    config:
      command: ${HOME}/repos/gitea/host-forge-scripts/scripts/run-githost-mcp-security.py
      env:
        AGENT_ID: security
      tool_denylist:
        - git_tag
        - git_checkout            # security works on main only
        - release
        - npm_publish
        - pypi_publish
        - gitea_create_release
        - github_create_release
        - gitlab_create_release
        - woodpecker_trigger
        - woodpecker_pipeline_cancel
        - woodpecker_list_pipelines
        - woodpecker_get_logs
        - woodpecker_status
        - gitea_pr_create         # security files reports directly, no PRs
        - gitea_pr_merge
        - gitea_pr_comment
        - gitea_pr_get
        - gitea_pr_list
        - github_pr_list
        - github_pr_comments
        - gitlab_mr_list
        - audit_log_query         # admin tool

  matrix:
    config:
      allowed_rooms:
        - "<room-id>"    # #forge:example.com (audit completion → resume signal)
        - "<room-id>"    # #security:example.com
        - "<room-id>"    # #announcements:example.com

  matrix-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8487/mcp

rate_limits:
  global: "60/minute"
  per_tool:
    "system-ops_run_command": "30/minute"
    "signoz-mcp_search_traces": "30/minute"
    "signoz-mcp_tail_logs": "30/minute"

audit:
  agent_bus_emit: true
  agent_bus_comms_dir: "~/.claude/comms"
  log_args: true

argument_filters:
  - name: "credential-leak"
    pattern: "(password|secret|api[_.]?key|bearer\\s+[A-Za-z0-9])"
    fields: ["*"]
    action: warn
    case_insensitive: true

  - name: "path-traversal"
    pattern: "\\.\\./|\\.\\.\\\\"
    fields: ["path", "file_path", "target", "src", "dst", "destination"]
    action: block
    decode: [url]

  - name: "shell-injection-warn"
    pattern: "rm\\s+-rf\\s+/|>\\s*/etc/|/etc/shadow|/etc/passwd"
    fields: ["command"]
    action: warn

response_filters:
  - name: "response-credential-leak"
    pattern: "(sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|AKIA[A-Z0-9]{16}|ya29\\.[a-zA-Z0-9_-]{50,})"
    action: redact
    decode: [base64]

  - name: "response-injection-attempt"
    pattern: "ignore (all |previous )?(instructions|prompt)|you are now|disregard your"
    action: warn
    case_insensitive: true

workspace_access:
  - path: ~/repos/gitea/host-forge-build-reports/
    access: readwrite
    git_backed: true
    branch_required: false
  - path: ~/.claude/memory/agents/security/
    access: readwrite
    git_backed: false
  - path: ~/.claude/memory/shared/
    access: readwrite
    git_backed: false
  - path: ~/.claude/comms/
    access: readwrite
    git_backed: false
