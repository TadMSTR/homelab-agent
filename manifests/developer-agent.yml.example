agent_type: developer
description: "Developer agent — forge code development"

state_backend:
  type: dragonfly
  url: "${DRAGONFLY_URL}"

max_auto_risk: low
interaction_permissions:
  auto_approved:
    - research    # build plan handoffs
    - security    # audit-complete return tasks
    - writer      # doc tasks (always safe)
  needs_approval: []

credentials:
  source: vault
  vault:
    addr: "${VAULT_ADDR}"
    auth: approle
    role_id_env: VAULT_ROLE_ID
    secret_id_env: VAULT_SECRET_ID
    path: "agents/{agent_type}"
    kv_version: 2

modules:
  system-ops:
    type: mcp_proxy
    config:
      url: http://localhost:8282/mcp

  githost-mcp:
    type: mcp_proxy
    config:
      command: /home/ted/repos/gitea/host-forge-scripts/scripts/run-githost-mcp-developer.py
      env:
        AGENT_ID: developer
      # SECURITY[control]: log_args:true logs call arguments only — tool responses are NOT
      # logged by scoped-mcp (confirmed in scoped_mcp/audit.py). woodpecker_get_logs response
      # (pipeline output, may contain secrets) is never written to the agent audit trail.
      # Audit: 2026-05-31/githost-mcp-expansion-2026-05.

  searxng-mcp:
    type: mcp_proxy
    config:
      command: /home/ted/scripts/run-searxng-mcp.sh
      tool_denylist:
        - clear_cache

  qmd:
    type: mcp_proxy
    config:
      url: http://localhost:8181/mcp

  graphiti:
    type: mcp_proxy
    config:
      url: http://localhost:8000/mcp
      tool_denylist:
        - clear_graph

  memory-metadata-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8490/mcp

  memsearch-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8493/mcp
      headers:
        Authorization: "Bearer ${MEMSEARCH_API_TOKEN}"

  task-queue-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8485/mcp

  langfuse-mcp:
    type: mcp_proxy
    config:
      command: /home/ted/scripts/run-langfuse-mcp.sh

  plane-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8495/mcp
      headers:
        Authorization: "Bearer ${PLANE_TOKEN}"
        x-workspace-slug: "${PLANE_WORKSPACE}"

  context7:
    type: mcp_proxy
    config:
      url: https://mcp.context7.com/mcp
      headers:
        CONTEXT7_API_KEY: "${CONTEXT7_API_KEY}"

  agent-bus:
    type: mcp_proxy
    config:
      command: /home/ted/repos/personal/agent-bus/venv/bin/python3
      args: ["/home/ted/repos/personal/agent-bus/server.py"]

  matrix:
    config:
      allowed_rooms:
        - "<room-id>"    # #dev:helmforge.me
        - "<room-id>"    # #announcements:helmforge.me

  matrix-mcp:
    type: mcp_proxy
    config:
      url: http://localhost:8487/mcp

rate_limits:
  global: "120/minute"
  per_tool:
    "system-ops_run_command": "60/minute"    # prevent runaway build loops

hitl:
  timeout_seconds: 300
  approval_required:
    - "githost-mcp_gitea_pr_merge"
    - "githost-mcp_woodpecker_pipeline_cancel"
  notify:
    type: matrix
    room: "<room-id>"   # #dev:helmforge.me

audit:
  agent_bus_emit: true
  agent_bus_comms_dir: "~/.claude/comms"
  log_args: true

argument_filters:
  - name: "credential-leak"
    pattern: "(password|secret|api[_.]?key|bearer\\s+[A-Za-z0-9])"
    fields: ["*"]
    action: warn
    case_insensitive: true

  - name: "path-traversal"
    pattern: "\\.\\./|\\.\\.\\\\"
    fields: ["path", "file_path", "target", "src", "dst", "destination"]
    action: block
    decode: [url]

  - name: "shell-injection-warn"
    pattern: "rm\\s+-rf\\s+/|>\\s*/etc/|/etc/shadow|/etc/passwd"
    fields: ["command"]
    action: warn

response_filters:
  - name: "response-credential-leak"
    pattern: "(sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|AKIA[A-Z0-9]{16}|ya29\\.[a-zA-Z0-9_-]{50,})"
    action: redact
    decode: [base64]

  - name: "response-injection-attempt"
    pattern: "ignore (all |previous )?(instructions|prompt)|you are now|disregard your"
    action: warn
    case_insensitive: true

workspace_access:
  - path: ~/repos/gitea/agent-platform-agents/
    access: readwrite
    git_backed: true
    branch_required: false
  - path: ~/repos/gitea/agent-platform-skills/
    access: readwrite
    git_backed: true
    branch_required: false
  - path: ~/repos/personal/
    access: readwrite
    git_backed: true
    branch_required: true
  - path: ~/.claude/memory/agents/developer/
    access: readwrite
    git_backed: false
  - path: ~/.claude/memory/shared/
    access: readwrite
    git_backed: false
  - path: ~/.claude/comms/
    access: readwrite
    git_backed: false
