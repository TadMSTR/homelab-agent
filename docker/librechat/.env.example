ANTHROPIC_API_KEY=

# JWT / encryption
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Registration: start true, lock down after creating accounts
ALLOW_REGISTRATION=

# Meilisearch
MEILI_MASTER_KEY=

# MongoDB
MONGO_USERNAME=
MONGO_PASSWORD=

# MCP service account (create this user in LibreChat post-deploy)
LIBRECHAT_MCP_EMAIL=
LIBRECHAT_MCP_PASSWORD=

# Web search — local forge containers (no real API keys needed)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
JINA_API_KEY=
JINA_API_URL=

# Web search provider URLs (referenced as ${VAR} in librechat.yaml)
SEARXNG_INSTANCE_URL=
